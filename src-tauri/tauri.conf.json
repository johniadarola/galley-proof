{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Galley Proof",
  "version": "0.1.0",
  "identifier": "com.johniadarola.bookwriter",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Galley Proof",
        "width": 1280,
        "height": 860,
        "minWidth": 420,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Write on finished book pages",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
