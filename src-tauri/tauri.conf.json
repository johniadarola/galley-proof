{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Galley Proof",
  "version": "0.4.1",
  "identifier": "com.johniadarola.bookwriter",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Galley Proof",
        "width": 1280,
        "height": 860,
        "minWidth": 420,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Write on finished book pages",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5NDg0Qjg2MDUwQkM5M0EKUldRNnlRc0Zoa3RJQ2R4VmptTXQzNDA1dGduQUpMVVZweENNdytlYlpoUTRWSkJDaTZpN0x4azcK",
      "endpoints": [
        "https://github.com/johniadarola/galley-proof/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
